# Bu dosyayı .env olarak kopyala ve kendi değerlerini gir.
# .env dosyası .gitignore'da olduğu için repoya girmez.

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=social_library

# E-posta: kayıt doğrulama kodu ve şifre sıfırlama için (zorunlu sayılır, yoksa kayıt tamamlanamaz).
# Brevo örneği: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USERNAME=Brevo giriş adresi,
# SMTP_PASSWORD=Brevo'da oluşturulan SMTP anahtarı (xsmtpsib-...), SMTP_FROM_EMAIL=Brevo'da doğrulanmış gönderen adresi.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Sosyal Kütüphane
# Brevo HTTPS API anahtarı (xkeysib-...). Doluysa e-postalar SMTP yerine bu API ile gönderilir (önerilir).
BREVO_API_KEY=
SITE_URL=http://localhost:8000

# TMDB (api/tmdb-proxy.php sunucu tarafında kullanır — bkz. README, anahtarı kendi TMDB hesabından al)
TMDB_API_KEY=

# Google Books (opsiyonel — api/books-proxy.php kullanır). Boş bırakılırsa anahtarsız/
# anonim kota kullanılır ve bu kota günlük olarak hızla dolabilir (429 hatası).
# Google Cloud Console'dan "Books API"yi etkinleştirip ücretsiz bir anahtar oluşturarak eklenebilir.
GOOGLE_BOOKS_API_KEY=

# Yöneticiler (virgülle ayrılmış e-postalar). Boşsa api/lib/admins.php'deki varsayılan kullanılır. setup-db.php her açılışta
# listedeki hesapları yönetici yapar, listede olmayan herkesten yönetici yetkisini alır.
# ADMIN_EMAILS=ben@ornek.com,arkadas@ornek.com

# Yapay zekâ destekli yorum moderasyonu (opsiyonel). Boş bırakılırsa yalnızca kelime listesi çalışır ve hiçbir metin dışarı gönderilmez.
# Sağlayıcı: gemini veya deepseek. Yalnızca herkese açık yorumlar gönderilir; özel mesajlar (DM) asla gönderilmez.
# Gemini seçiliyse yüklenen profil fotoğrafı da cinsel içerik, şiddet / vahşet ve terör için taranır (görsel Google'a gönderilir, sunucuda
# saklanmaz). Hareketli GIF/WebP kabul edilmez; anahtar tanımlıyken kontrol edilemezse yükleme reddedilir. DeepSeek görsel anlamaz.
LLM_MODERATION_PROVIDER=
LLM_MODERATION_API_KEY=
# LLM_MODERATION_MODEL=gemini-3.1-flash-lite
# LLM_MODERATION_TIMEOUT=4
